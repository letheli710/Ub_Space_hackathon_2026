  "components": {
    "schemas": {
      "ArmCommand": {
        "properties": {
          "targets": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "minProperties": 1,
            "title": "Targets"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "targets"
        ],
        "title": "ArmCommand"
      },
      "CycleRequest": {
        "properties": {
          "execute": {
            "type": "boolean",
            "title": "Execute",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CycleRequest"
      },
      "DisasterCommand": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "severity": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Severity",
            "default": 65
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "DisasterCommand"
      },
      "EmptyRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "EmptyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoopRequest": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "running"
        ],
        "title": "LoopRequest"
      },
      "MapControl": {
        "properties": {
          "orbit_speed": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Orbit Speed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "orbit_speed"
        ],
        "title": "MapControl"
      },
      "SolarPanelCommand": {
        "properties": {
          "target_rad": {
            "type": "number",
            "title": "Target Rad"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_rad"
        ],
        "title": "SolarPanelCommand"
      },
      "SystemId": {
        "type": "string",
        "enum": [
          "main_judging",
          "energy",
          "propelling",
          "robot_arms"
        ],
        "title": "SystemId"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorldControl": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paused"
        ],
        "title": "WorldControl"
      }
    }
  }
